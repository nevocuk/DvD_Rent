@{@*
    Sayfa başlığı ve ViewBag üzerinden müşteri, film ve aktif kiralama sayıları alınır
*@
    ViewBag.Title = "Yeni Kiralama";
    var musteriler = ViewBag.Musteriler as List<DVD_Rent.Models.Musteri>;
    var filmler = ViewBag.Filmler as List<DVD_Rent.Models.Film>;
    var aktifKiralamaSayilari = ViewBag.AktifKiralamaSayilari as Dictionary<int, int>;
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<h2 style="text-align:center;">Yeni Kiralama</h2>
<div class="film_form">
    <form asp-action="KiralamaEkle" method="post" autocomplete="off" id="kiralamaForm">
        <label>Müşteri</label>
        <select name="musteri_id" id="musteri_id" class="select2" required>
            <option value="">Müşteri seçiniz</option>
            @if (musteriler != null)
            {
                foreach (var m in musteriler)
                {
                    var aktifKiralama = aktifKiralamaSayilari != null && aktifKiralamaSayilari.ContainsKey(m.musteri_id)
                        ? aktifKiralamaSayilari[m.musteri_id]
                        : 0;

                    if (aktifKiralama >= 3)
                    {
                        <option value="@m.musteri_id" disabled style="color:#aaa;">
                            @m.isim @m.soyisim (Kalan Kiralama: 0 - Maksimum kiralama)
                        </option>
                    }
                    else
                    {
                        <option value="@m.musteri_id">
                            @m.isim @m.soyisim (Kalan Kiralama: @(3 - aktifKiralama))
                        </option>
                    }
                }
            }
        </select>

        <label>Film</label>
        <select name="film_id" id="film_id" class="select2" required>
            <option value="">Film seçiniz</option>
            @if (filmler != null)
            {
                foreach (var f in filmler)
                {
                    if (f.kopya_sayisi < 1)
                    {
                        <option value="@f.film_id" disabled style="color:#aaa;">
                            @f.ad (Stokta yok)
                        </option>
                    }
                    else
                    {
                        <option value="@f.film_id">
                            @f.ad (Stok: @f.kopya_sayisi)
                        </option>
                    }
                }
            }
        </select>

        <label>Kaç gün kiralanacak?</label>
        <input type="number" id="gunSayisi" name="gunSayisi" min="1" value="1" required />

        @if (ViewBag.Hata != null)
        {
            <div style="color:red; margin-top:10px;">@ViewBag.Hata</div>
        }

        <button type="submit" class="btn btn-primary">Kirala</button>
    </form>

    <a asp-action="Kiralama" style="margin-top:10px; display:block; text-align:center;">Kiralama Listesine Dön</a>
    <div style="margin-top:10px; font-weight:bold; font-size:1.1em;">
        <span id="toplamFiyat">Toplam: 5₺</span>
    </div>
</div>
<br><br><br>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $(document).ready(function() {
        $('.select2').select2({
            placeholder: "Seçiniz",
            allowClear: true,
            width: 'resolve',
            minimumInputLength: 0
        });
    });
//Fiyat Hesaplaması Yapılır
    const gunInput = document.getElementById("gunSayisi");
    const toplamFiyat = document.getElementById("toplamFiyat");
    const GUNLUK_FIYAT = 5;

    function fiyatGuncelle() {
        let gun = parseInt(gunInput.value) || 1;
        if (gun < 1) gun = 1;
        toplamFiyat.textContent = "Toplam: " + (gun * GUNLUK_FIYAT) + "₺";
    }

    gunInput.addEventListener("input", fiyatGuncelle);
    fiyatGuncelle();
</script>